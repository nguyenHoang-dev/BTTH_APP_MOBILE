# ==============================================================================
# CẤU HÌNH MÁY CHỦ AI (NODE.JS + GEMINI) - NHÓM 5
# ==============================================================================
# HƯỚNG DẪN SỬ DỤNG CHO TRƯỞNG NHÓM & CÁC THÀNH VIÊN:
# 1. Lấy khóa Gemini API miễn phí tại: https://aistudio.google.com/app/apikey
# 2. Nếu đang mở file ".env.example", hãy copy ra thành file ".env" cùng thư mục
#    (hoặc sửa trực tiếp trong file "server/.env" trên máy của bạn).
# 3. Dán khóa API thật của bạn vào sau dấu "=" ở dòng GEMINI_API_KEY bên dưới
#    (thay thế cho chữ your_gemini_api_key_here).
# 4. LƯU Ý BẢO MẬT (RUBRIC): File ".env" đã được chặn trong .gitignore,
#    TUYỆT ĐỐI KHÔNG commit khóa API thật lên GitHub để tránh bị trừ 10 điểm!
# ==============================================================================

# 👉 NHẬP KEY GEMINI CỦA BẠN VÀO ĐÂY ĐỂ DÙNG AI THẬT (Nếu để trống sẽ chạy chế độ Demo):
GEMINI_API_KEY=your_gemini_api_key_here

# Model Gemini sử dụng (mặc định: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Cổng chạy server Node.js (mặc định: 3000)
PORT=3000

# Thời gian chờ tối đa khi gọi Gemini (mặc định: 12000ms = 12 giây)
GEMINI_TIMEOUT_MS=12000

# Giới hạn số lượt gọi AI theo IP (mặc định: tối đa 15 lần / 60000ms = 1 phút)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=15
