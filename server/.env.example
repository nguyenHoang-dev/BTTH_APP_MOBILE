# ==============================================================================
# CẤU HÌNH MÁY CHỦ AI (NODE.JS + GEMINI) - NHÓM 5
# ==============================================================================
# HƯỚNG DẪN DÙNG NHANH:
# - Lấy khóa Gemini API miễn phí tại: https://aistudio.google.com/app/apikey
# - Xóa dòng chữ tiếng Việt sau dấu "=" ở mục GEMINI_API_KEY bên dưới và dán
#   khóa API thật của bạn vào là chạy được ngay (không cần đổi tên file).
# ==============================================================================

# 👉 DÁN KEY GEMINI CỦA BẠN VÀO SAU DẤU "=" Ở DÒNG DƯỚI ĐÂY:
GEMINI_API_KEY=NHAP_KEY_GEMINI_CUA_BAN_VAO_DAY

# Model Gemini sử dụng (mặc định: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Cổng chạy server Node.js (mặc định: 3000)
PORT=3000

# Thời gian chờ tối đa khi gọi Gemini (mặc định: 12000ms = 12 giây)
GEMINI_TIMEOUT_MS=12000

# Giới hạn số lượt gọi AI theo IP (mặc định: tối đa 15 lần / 60000ms = 1 phút)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=15
