{
  "name": "bilingual-quiz-ai-server",
  "version": "1.0.0",
  "description": "Backend trung gian (BFF) giữ GEMINI_API_KEY cho app Flutter Ôn tập trắc nghiệm song ngữ",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "validate": "node scripts/validate_questions.js",
    "test": "node --test test/server.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "nodemonConfig": {
    "watch": ["src", ".env"],
    "ext": "js,json"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}

